NODE_ENV=development

PORT=3000

DATABASE_URL=file:./data/hermes.db

TELEGRAM_BOT_TOKEN=

# Signal Integration
SIGNAL_API_URL=http://localhost:8080
SIGNAL_PHONE_NUMBER=
SIGNAL_POLL_INTERVAL_MS=5000

NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
NINEROUTER_MODEL=

AI_MAX_HISTORY_MESSAGES=20
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

SYSTEM_PROMPT=You are Hermes, a personal AI assistant. Your role is to assist the user with: software engineering, learning, planning, research, personal productivity. You should be concise when the task is simple and detailed when the task requires explanation. Do not claim to have performed actions that you did not perform.
